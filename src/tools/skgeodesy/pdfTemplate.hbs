        <div class="col-span-3">
          <p class="text-xs uppercase tracking-wide text-gray-500">Informatívny sumár</p>
          <h1 class="text-xl font-semibold">
            Výpis z listov vlastníctva – {{ header.cadastralAreaName }}
          </h1>

          <!-- Meta -->
          <dl class="mt-2 grid grid-cols-1 sm:grid-cols-3 gap-2 text-sm">
            <div>
              <dt class="text-gray-500">Dátum a čas vyhotovenia</dt>
              <dd class="font-medium">{{ createdAt }}</dd>
            </div>
            <div>
              <dt class="text-gray-500">Katastrálne územie</dt>
              <dd class="font-medium">
                {{ header.cadastralAreaCode }} – {{ header.cadastralAreaName }}
              </dd>
            </div>
            <div>
              <dt class="text-gray-500">Obec / Okres</dt>
              <dd class="font-medium">
                {{ header.cadastralAreaName }} / {{ header.districtName }}
              </dd>
            </div>
          </dl>
        </div>
        <button
          onclick="window.print()"
          class="col-span-1 no-print rounded-lg border px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50"
        >
          Tlačiť
        </button>
      </header>

      <!-- Quick stats -->
      <section class="mt-5">
        <h2 class="sr-only">Kľúčové štatistiky</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
          <div class="rounded-xl border p-3">
            <div class="text-xs text-gray-500">Počet parciel</div>
            <div class="mt-1 text-lg font-semibold tabular-nums">{{ quickStats.parcelCount }}</div>
          </div>
          <div class="rounded-xl border p-3">
            <div class="text-xs text-gray-500">Celková výmera</div>
            <div class="mt-1 text-lg font-semibold tabular-nums">
              {{ quickStats.totalAreaM2 }} m²
            </div>
          </div>
          <div class="rounded-xl border p-3">
            <div class="text-xs text-gray-500">Počet stavieb</div>
            <div class="mt-1 text-lg font-semibold tabular-nums">
              {{ quickStats.structureCount }}
            </div>
          </div>
          <div class="rounded-xl border p-3">
            <div class="text-xs text-gray-500">Počet unikátnych vlastníkov</div>
            <div class="mt-1 text-lg font-semibold tabular-nums">{{ quickStats.ownerCount }}</div>
          </div>
        </div>
      </section>

      <!-- Parcels table -->
      <section class="mt-6">
        <h2 class="text-sm font-semibold text-gray-700">Rýchly zoznam parciel</h2>
        <div class="mt-2 overflow-hidden rounded-xl border">
          <table class="min-w-full text-sm border-collapse">
            <thead class="bg-blue-100">
              <tr>
                <th class="px-3 py-2 text-center font-medium">Parcelné číslo</th>
                <th class="px-3 py-2 text-center font-medium">Výmera</th>
                <th class="px-3 py-2 text-center font-medium">Druh pozemku</th>
                <th class="px-3 py-2 text-center font-medium">Využitie</th>
                <th class="px-3 py-2 text-center font-medium">Stavby</th>
                <th class="px-3 py-2 text-center font-medium">Vlastníci</th>
              </tr>
            </thead>
            <tbody>
              {{#each parcels}}
              <tr class="parcel-row {{parity @index}}  avoid-break align-top">
                <td class="px-3 py-2 font-semibold whitespace-nowrap tabular-nums align-top">{{~parcelType~}}-{{~parcelNumber~}}</td>
                <td class="px-3 py-2 tabular-nums whitespace-nowrap align-top">{{~areaM2~}} m²</td>
                <td class="px-3 py-2 align-top">{{~landUseType~}}</td>
                <td class="px-3 py-2 align-top leading-relaxed break-words">{{~landUseText~}}</td>
                <td class="px-3 py-2 align-top">
                  {{#each structures}}
                  <ul class="list-disc pl-5 space-y-0.5">
                    {{#each structures}}<li>{{~description~}}</li>{{/each}}
                  </ul>
                  {{/each}}</td>
                <td class="px-3 py-2 align-top">
                  {{#if owners.length}}
                    <ul class="list-disc pl-5 space-y-0.5 text-left text-sm">
                      {{#each owners}}
                        <li>
                          {{#each people}}
                            <span class="font-medium">{{~.~}}</span>{{#unless @last}}, {{/unless}}
                          {{/each}}
                        </li>
                      {{/each}}
                    </ul>
                  {{else}}—{{/if}}
                  </td>
              </tr>
                <tr class="encumbrance-row {{parity @index}}  avoid-break border-b">
                  <td colspan="6" class="px-3 py-2">
                    <div class="text-xs text-gray-700 text-left">
              {{#if encumbrances.length}}
                      <strong class="pl-1">Ťarchy:</strong>
                      <ul class="list-decimal pl-6 space-y-0.5 leading-relaxed text-left">
                        {{#each encumbrances}}
                          <li>{{~.~}}</li>
                        {{/each}}
                      </ul>
                {{/if}}
                    </div>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Disclaimer -->
      <footer class="mt-8 border-t pt-4">
        <p class="text-xs text-gray-500 leading-relaxed">
          Tento sumár je informatívny a nepoužiteľný na právne úkony. Úplné a záväzné údaje sú
          uvedené v oficiálnom výpise.
        </p>
      </footer>
    </div>
    {{#each lvs}}
        {{{.}}}
        <hr style="break-after: page;">
    {{/each}}
  </body>
</html>
